# MongoDB connection string (required for production)
# Get a free cluster at https://mongodb.com/cloud/atlas
# Example: mongodb+srv://username:password@cluster.mongodb.net/betswal
MONGODB_URI=mongodb://127.0.0.1:27017/betswal

# Server
PORT=3001

# CORS
# ALLOWED_ORIGINS=https://your-frontend.com

# Self-ping (set to your deployed backend URL)
# PUBLIC_URL=https://your-backend.onrender.com

# Twilio (optional — for OTP)
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_VERIFY_SERVICE_SID=

# Payhero M-Pesa STK Push
PAYHERO_API_USERNAME=
PAYHERO_API_PASSWORD=
PAYHERO_CHANNEL_ID=
PAYHERO_CALLBACK_URL=
